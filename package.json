{
  "name": "naked-fetch",
  "version": "0.1.0",
  "description": "AI 专属网页抓取器：零依赖（不穿依赖直接抓）。完整浏览器指纹 + HTML→AI 友好文本提取 + SPA 检测 + Via 模式复用系统内核",
  "type": "module",
  "main": "index.js",
  "bin": {
    "naked-fetch": "cli.js"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./core/fingerprint": "./core/fingerprint.js",
    "./core/extract": "./core/extract.js",
    "./core/fetch": "./core/fetch.js",
    "./core/search": "./core/search.js",
    "./core/browser": "./core/browser.js",
    "./core/gecko": "./core/gecko.js"
  },
  "files": [
    "index.js",
    "cli.js",
    "core/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "node --check cli.js && node --check index.js && node --check core/*.js"
  },
  "keywords": [
    "web",
    "scraper",
    "crawler",
    "fetch",
    "search",
    "ai",
    "llm",
    "readability",
    "fingerprint",
    "zero-dependency"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "playwright": "^1.62.1"
  }
}